{
  "name": "ddd-builder",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/design.test.mjs tests/documents.test.mjs tests/server.test.mjs tests/mcp.test.mjs tests/security.test.mjs tests/auth.test.mjs",
    "mcp": "node mcp/index.mjs",
    "test:e2e": "playwright test",
    "test:docker": "node --test tests/docker.test.mjs",
    "format": "prettier --write src server mcp scripts tests *.json *.ts index.html"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dompurify": "^3.4.16",
    "lucide-react": "^0.577.0",
    "mermaid": "^12.1.0",
    "openid-client": "^6.8.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "overrides": {
    "mermaid": {
      "katex": "0.18.2"
    }
  }
}
