# Configure OIDC for production. Workshop mode must be selected explicitly.
DDD_PORT=3210
DDD_BIND_ADDRESS=127.0.0.1
DDD_CONTAINER_NAME=ddd-builder

# Set the host computer's LAN address to advertise it in the invite dialog.
# Opt in to LAN connections by setting DDD_BIND_ADDRESS=0.0.0.0.
# PUBLIC_URL=http://192.168.0.108:3210

# Leave empty to generate and persist a random access code in the data volume.
ACCESS_CODE=

# Official service: requires registered OIDC and a verified owner email.
# No fallback to shared access codes in production mode.
SERVICE_MODE=production
AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OWNER_EMAIL=
